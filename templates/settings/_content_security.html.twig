{% embed 'settings/_card.html.twig' with { heading: 'content_security.heading'|trans } %}
{% block body %}
{% set segText = 'flex h-full items-center justify-center px-3 py-1.5 text-center text-[11px] leading-tight text-ink-muted
                  peer-checked:bg-accent peer-checked:text-accent-ink
                  peer-focus-visible:ring-2 peer-focus-visible:ring-inset peer-focus-visible:ring-accent
                  transition-colors cursor-pointer' %}

<div class="px-4 py-3">

<form method="post" action="{{ path('app_settings_content_security_update') }}" data-turbo="false" data-controller="ui--auto-submit">
    <input type="hidden" name="_token" value="{{ csrf_token('settings-content-security') }}">

    <div class="flex items-start justify-between gap-3">
        <span class="min-w-0">
            <span class="block text-xs font-medium text-ink-muted">{{ 'content_security.https_only'|trans }}</span>
            <span class="block text-[11px] text-ink-faint mt-0.5">{{ 'content_security.hint'|trans }}</span>
        </span>

        <div class="grid grid-flow-col auto-cols-fr shrink-0 rounded-pane border border-line overflow-hidden"
             role="radiogroup" aria-label="{{ 'content_security.https_only'|trans }}">
            {% for on in [true, false] %}
                <label>
                    <input type="radio" name="httpsOnly" class="peer sr-only"
                           value="{{ on ? '1' : '0' }}"
                           data-action="change->ui--auto-submit#submit"
                           {{ app.user.remoteHttpsOnly == on ? 'checked' : '' }}>
                    <span class="{{ segText }}">
                        {{ (on ? 'settings.images.on' : 'settings.images.off')|trans }}
                    </span>
                </label>
            {% endfor %}
        </div>
    </div>
</form>

</div>

{% endblock %}
{% endembed %}
