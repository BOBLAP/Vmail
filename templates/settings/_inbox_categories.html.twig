{#
settings/_inbox_categories.html.twig
─────────────────────────────────────────────────────────────────────────────
The inbox tabs this person made, beside the five that come with plMail.

A category is only a name. What goes into it is decided by a filter's "File in
category" action, so the card says so and links there — a tab with nothing
filing into it stays out of the strip, and a card that did not explain that
would look broken the first time somebody made one.

Plain posts that redirect back, like the sorting card above: three small writes
on a short list.

Accepts:
  categories  InboxCategory[]  in the order their tabs are drawn
#}
<div class="px-4 py-3">
    <p class="text-[11px] text-ink-faint">
        {{ 'settings.categories.hint'|trans }}
        <a href="{{ path('app_settings_index', { section: 'filters' }) }}" class="text-accent hover:underline">{{ 'settings.categories.filters_link'|trans }}</a>
    </p>

    {% if categories is empty %}
        <p class="mt-3 text-xs text-ink-faint" data-inbox-categories-empty>{{ 'settings.categories.empty'|trans }}</p>
    {% else %}
        <ul class="mt-3 divide-y divide-line rounded-pane border border-line" data-inbox-categories>
            {% for category in categories %}
                <li class="flex items-center gap-2 px-3 py-2">
                    <form method="post" action="{{ path('app_settings_categories_rename', { id: category.id }) }}"
                          data-turbo="false" class="flex min-w-0 flex-1 items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('settings-categories') }}">
                        <input type="text" name="name" value="{{ category.name }}" required maxlength="40"
                               aria-label="{{ 'settings.categories.name_label'|trans }}"
                               class="min-w-0 flex-1 h-8 rounded-pane border border-line bg-surface px-2 text-sm text-ink">
                        <button type="submit"
                                class="shrink-0 h-8 px-2.5 rounded-pane border border-line text-xs text-ink-muted hover:text-ink hover:bg-hover cursor-pointer transition-colors">
                            {{ 'settings.categories.rename'|trans }}
                        </button>
                    </form>

                    <form method="post" action="{{ path('app_settings_categories_delete', { id: category.id }) }}"
                          data-turbo="false"
                          data-turbo-confirm="{{ 'settings.categories.delete_confirm'|trans({ '%name%': category.name }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('settings-categories') }}">
                        <button type="submit"
                                class="shrink-0 w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint hover:text-danger hover:bg-hover cursor-pointer transition-colors"
                                aria-label="{{ 'settings.categories.delete'|trans }}"
                                title="{{ 'settings.categories.delete'|trans }}">
                            <i class="fa-solid fa-trash text-xs" aria-hidden="true"></i>
                        </button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <form method="post" action="{{ path('app_settings_categories_create') }}" data-turbo="false" class="mt-3 flex items-center gap-2">
        <input type="hidden" name="_token" value="{{ csrf_token('settings-categories') }}">
        <input type="text" name="name" required maxlength="40"
               placeholder="{{ 'settings.categories.placeholder'|trans }}"
               aria-label="{{ 'settings.categories.name_label'|trans }}"
               class="min-w-0 flex-1 h-8 rounded-pane border border-line bg-surface px-2 text-sm text-ink">
        <button type="submit"
                class="shrink-0 inline-flex items-center gap-1.5 px-2.5 h-8 rounded-lg text-xs font-medium bg-accent hover:bg-accent-strong text-accent-ink transition-colors cursor-pointer">
            <i class="fa-solid fa-plus text-[10px]" aria-hidden="true"></i>
            {{ 'settings.categories.add'|trans }}
        </button>
    </form>
</div>
