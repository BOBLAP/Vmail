{% embed 'settings/_card.html.twig' with {
    heading: 'sync_frequency.title'|trans,
    subheading: 'sync_frequency.description'|trans,
    padded: true,
} %}
    {% block body %}
        <form method="post" action="{{ path('app_settings_sync_frequency') }}" data-controller="settings--sync-frequency">
            <input type="hidden" name="_token" value="{{ csrf_token('sync-frequency') }}">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {% for key, group in syncGroups %}
                    <section class="min-w-0 rounded-lg border border-line bg-raised p-3"
                             data-sync-group="{{ key }}"
                             data-action="dragover->settings--sync-frequency#allowDrop drop->settings--sync-frequency#drop">
                        <label class="block font-semibold text-ink" for="sync-interval-{{ key }}">
                            {{ ('sync_frequency.group.' ~ key)|trans }}
                        </label>
                        <div class="mt-1 flex items-center gap-2">
                            <input id="sync-interval-{{ key }}" class="w-20 rounded border border-field bg-field px-2 py-1"
                                   type="number" min="1" max="1440" required name="interval[{{ key }}]" value="{{ group.minutes }}">
                            <span class="text-sm text-ink-muted">{{ 'sync_frequency.minutes'|trans }}</span>
                        </div>
                        <ul data-settings--sync-frequency-target="list" data-group="{{ key }}" class="mt-3 min-h-16 space-y-2">
                            {% for account in group.accounts %}
                                <li class="rounded-lg border border-line bg-surface px-2 py-2">
                                    <span draggable="true" class="block cursor-grab truncate text-sm font-medium text-ink"
                                          data-action="dragstart->settings--sync-frequency#start dragend->settings--sync-frequency#end"
                                          title="{{ account.email }}">{{ account.email }}</span>
                                    <select name="group[{{ account.id }}]" aria-label="{{ 'sync_frequency.group_for'|trans({'%account%': account.email}) }}"
                                            class="mt-1 w-full rounded border border-field bg-field px-1 py-1 text-sm"
                                            data-action="change->settings--sync-frequency#choose">
                                        {% for option in syncGroups|keys %}
                                            <option value="{{ option }}" {{ option == key ? 'selected' : '' }}>{{ ('sync_frequency.group.' ~ option)|trans }}</option>
                                        {% endfor %}
                                    </select>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endfor %}
            </div>
            <button type="submit" class="mt-4 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-ink hover:bg-accent-strong focus-visible:ring-2 focus-visible:ring-accent">
                {{ 'sync_frequency.save'|trans }}
            </button>
        </form>
    {% endblock %}
{% endembed %}
